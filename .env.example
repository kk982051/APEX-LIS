# ==============================================================================
# APEX VETLIS ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (Supabase PostgreSQL or Local SQLite)
# Replace [YOUR-PASSWORD] and [PROJECT-REF] with your Supabase credentials:
# 
# Option 1: Supabase Connection Pooler (Recommended - Port 6543 / 5432)
# DATABASE_URL=postgresql://postgres.yourprojectref:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#
# Option 2: Supabase Direct Connection (Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.yourprojectref.supabase.co:5432/postgres
#
# Option 3: Local SQLite (Default fallback if not set)
DATABASE_URL=sqlite:///./apex_vetlis.db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Server Binding
HOST=0.0.0.0
PORT=8000

# Hardware Analyzer TCP Ports
ASTM_PORT=5100
HL7_PORT=5101
